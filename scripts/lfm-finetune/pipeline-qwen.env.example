# Configuration for scripts/lfm-finetune/pipeline.sh (issue 46: the Apache-2.0
# Qwen3.5-0.8B tool-decision fine-tune, reusing issue 39's pipeline).
# Copy to a private file, fill in, and pass it with --env. Never commit keys:
# the key itself lives in an environment variable (for example set by
# `grant run`), and this file only names that variable.

# Where every intermediate file goes (splits, variations, training data, runs).
# Kept separate from the LFM2.5 run's WORK so the two never mix.
WORK=$PWD/qwen-work

# The training environment's Python (torch + unsloth + peft); see
# docs/lfm-finetune.md, "training environment". The same venv trains both
# bases.
TRAIN_PY=$PWD/lfm-train/.venv/bin/python

# Base model and the commit stock is measured as (Apache-2.0; NO Jinja
# generation-block markers in its chat template -- build_dataset.py and
# train.py both locate the answer in the rendered ids instead, issue 46).
BASE=Qwen/Qwen3.5-0.8B
BASE_REV=2fc06364715b967f1860aea9cf38778875588b17

# Repository id the tuned candidate is staged under in the HF cache, and
# uploaded to (private) by the `upload` stage. The GGUF/AWQ exports and the
# dataset get their own repos, named the same way, when a later stage
# publishes them.
REPO=jetson-ai-lab/qwen3.5-0.8b-nvsh-tool-jev

# The Hugging Face cache the Tier 2 launcher mounts ([tiers.lfm] hf_cache_dir).
HF_CACHE=$PWD/hf-cache

# An nvsh config.toml with [tiers] enabled and [tiers.lfm] pointed at this
# base's engine/parser (docs/tier2.md).
NVSH_CONFIG=$PWD/measure-config.toml

# The fixed grounding snapshot every measure stage passes to measure.py as
# --ground-snapshot (required; write it with `measure.py snapshot`), so each
# model is grounded against the same facts rather than the fixture world.
GROUND_SNAPSHOT=$PWD/qwen-work/ground-snapshot.json

# chat_template_kwargs enable_thinking sent with every measured request
# (--enable-thinking; issue 46 serves Qwen3.5 with false).
ENABLE_THINKING=false

# Seeded split.
SEED=46

# Augmentation: variations to attempt per train entry / per skill, and how
# many in flight at once (more than 2-4 can overload a shared gateway).
PER_SOURCE_NVSH=30
PER_SOURCE_SKILLS=24
WORKERS=2

# The four augment.py roles (OpenAI-compatible chat completions, localhost).
# Teachers for this run, all Apache-2.0: GENERATOR/worker (Qwen 3.6 35B-A3B),
# CORRECTOR/cortex (Qwen 3.8 27B), REVIEWER_A/senses (Gemma 4 26B-A4B),
# REVIEWER_B/cortex (Qwen 3.8 27B).
AUG_URL=http://localhost:8001/v1/chat/completions
AUG_KEY_ENV=NVSH_GATEWAY_KEY
AUG_GENERATOR_MODEL=worker
AUG_CORRECTOR_MODEL=cortex
AUG_REVIEWER_A_MODEL=senses
AUG_REVIEWER_B_MODEL=cortex

# Reply budgets: rewriting is short; reviewers are reasoning models and an
# empty reply (budget spent thinking) is retried, so give them room.
AUG_REWRITE_MAX_TOKENS=1024
AUG_REVIEWER_MAX_TOKENS=8192
AUG_REVIEWER_TIMEOUT=300

# Skill seeds and the name of the skill training set: tools.json writes
# requests from each skill's one-line description; bodies.json (written by the
# skills stage) from an excerpt of its SKILL.md, which gives longer, more
# specific requests. SKILLS_SET names aug/<set>-accepted.jsonl and
# data/<set>-train.jsonl, so the two never mix.
SKILLS_SEED=$PWD/qwen-work/skills/tools.json
SKILLS_SET=skills

# Train-only supplement appended at assemble (deviation d3); empty to leave it out.
SUPPLEMENT=$PWD/scripts/lfm-finetune/train-supplement.json

# Training settings (train.py flags); tune for the 0.8B base before a real run.
TRAIN_ARGS="--epochs 20 --lr 5e-4 --rank 32 --alpha 64 --batch 8 --seed 7"

# train_scorer.py flags for the `train-scorer` stage; empty uses its own defaults.
TRAIN_SCORER_ARGS=""

# Hard OS-level memory cap for every training/quantize stage (systemd-run's
# MemoryMax, e.g. "24G"). Required: a bare host must never train uncapped.
# spark2 has roughly 30 GB free next to its serving stack -- leave headroom.
TRAIN_MEMORY_MAX=24G

# Available-memory floor (capped.sh watchdog): a run is stopped when the
# machine's MemAvailable falls below it. On GB10 unified memory GPU
# allocations are NOT charged to the cgroup cap above, so this floor is what
# protects anything else running on the box. Checked every
# TRAIN_WATCHDOG_SECONDS (default 5).
TRAIN_MEMORY_FLOOR=8G
TRAIN_WATCHDOG_SECONDS=5
# GPU memory budget in GB for train.py/train_scorer.py
# (torch.cuda.set_per_process_memory_fraction). Empty: no per-process cap.
NVSH_TRAIN_GPU_MEMORY_GB=

# Optional: cap how many train-side texts quantize.py's calibration set uses.
CALIBRATION_LIMIT=

# The name of the environment variable that holds the Hugging Face token for
# the `upload` stage (injected by the operator, e.g. via `grant run --inject`).
# Never the token itself, and never printed.
HF_TOKEN_ENV=HF_TOKEN
