{"version": 2, "width": 100, "height": 34, "timestamp": 0, "env": {"SHELL": "", "TERM": "xterm-256color"}, "title": "nvsh: a failing command, diagnosed and fixed"}
[0.422871, "o", "\u001b]133;D;0\u0007"]
[0.423097, "o", "\u001b[?2004hnvsh$ "]
[1.975692, "o", "./run-model.sh\r\u001b[K\rnvsh$ ./run-model.sh\r\n\u001b[?2004l\r\u001b]133;C\u0007bash: ./run-model.sh: Permission denied\r\n\u001b]133;D;126\u0007"]
[2.23239, "o", "\u001b[1m\u001b[31mnvsh:\u001b[0m ./run-model.sh failed (exit 126), forwarding to demo\r\n"]
[2.232747, "o", "demo \u00b7 fixture \u00b7 warm\r\n"]
[2.360703, "o", "Exit 126 on this jetson box means the shell found ./run-model.sh but was not allowed to run it.\r\n"]
[2.360805, "o", "The file is not executable -- a copy, a git checkout or an unzip drops the bit.\r\nPutting it back is enough; nothing else about the script has to change.\r\n(scripted demo reply)\r\n"]
[2.360863, "o", "\r\n"]
[2.362946, "o", "\u001b[2mrestore the execute bit so the shell can run the script\u001b[0m\r\n+----------------------------------------------------------------------+\r\n"]
[2.362987, "o", "  \u001b[36mchmod +x ./run-model.sh\u001b[0m\r\n+----------------------------------------------------------------------+\r\n"]
[2.363012, "o", "\u001b[2m(fix)\u001b[0m\r\n"]
[2.363178, "o", "\u001b[2m[s] this exact line  [S] 'chmod +x *'  (this session)\u001b[0m\r\n\u001b[2m[u] 'chmod *'  [U] 'chmod +x *'  (persisted for you)\u001b[0m\r\n"]
[2.3632, "o", "[Enter] run [s/S] +session [u/U] +user [e] why [d] details [t] tell [Esc] ignore\r\n"]
[12.006786, "o", "nvsh: running ...\r\n\u001b[2mnvsh: chmod +x ./run-model.sh -> exit 0\u001b[0m\r\n"]
[12.018502, "o", "\u001b[?2004hnvsh$ "]
[18.477541, "o", "./run-model.sh\r\u001b[K\rnvsh$ ./run-model.sh\r\n\u001b[?2004l\r\u001b]133;C\u0007model loaded, 42 tokens/s\r\n\u001b]133;D;0\u0007\u001b[?2004hnvsh$ "]
[24.485822, "o", "exit\r\u001b[K\r"]
[24.485998, "o", "nvsh$ exit\r\n"]
[24.486038, "o", "\u001b[?2004l\r\u001b]133;C\u0007exit\r\n"]
